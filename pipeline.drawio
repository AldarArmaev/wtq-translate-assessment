<mxfile host="app.diagrams.net"><diagram id="wtq-pipeline" name="Pipeline оценки WTQ"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="700" pageHeight="1050"><root><mxCell id="0"/><mxCell id="1" parent="0"/>

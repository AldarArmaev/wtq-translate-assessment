<mxCell id="mentions" value="&lt;b&gt;Оценка упоминаний&lt;/b&gt;&lt;br&gt;&lt;br&gt;Сохранение масок и правильность связи вопроса с таблицей" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="110" y="480" width="480" height="95" as="geometry"/></mxCell>
